# Frontend (browser) — safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side only
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tier-1 routing provider (optional; OSRM + Haversine fall back automatically)
ORS_API_KEY=

# Error monitoring (Sentry / GlitchTip DSN). Leave blank to disable.
SENTRY_DSN=
APP_RELEASE=dev

# Set to "true" to switch server profiling off entirely
PROFILING_DISABLED=false